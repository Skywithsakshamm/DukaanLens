# DukaanLens Environment Variables
# Copy to .env for local development

# Google Gemini / Cloud Gemma Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Configurable model ID (default: gemma-4-26b-a4b-it, or switch to gemma-4-31b-it / gemini-2.5-flash)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Application Configuration
NODE_ENV=development
PORT=3000
DATA_DIR=./data
SESSION_SECRET=change-this-secure-session-secret-at-least-32-chars

# Mock AI Mode for automated tests or offline testing without Gemini quota
MOCK_AI=false
